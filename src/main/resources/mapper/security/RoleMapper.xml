<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunfeil161.ailibrary.config.security.role.mapper.RoleMapper">
    <resultMap id="RoleResultMap" type="com.yunfeil161.ailibrary.config.security.role.entity.Role">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="getRoleById" resultMap="RoleResultMap">
        select id, code, name, description, status, version, created_at, updated_at
        from `role`
        where id = #{id}
    </select>

    <select id="getRoleByCode" resultMap="RoleResultMap">
        select id, code, name, description, status, version, created_at, updated_at
        from `role`
        where code = #{code}
    </select>
</mapper>
