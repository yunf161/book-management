# 复制为部署环境变量或被Git忽略的local-secrets.properties；禁止使用示例密钥上线。
SPRING_PROFILES_ACTIVE=prod
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/library?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Hong_Kong
MYSQL_USERNAME=library_app
MYSQL_PASSWORD=REPLACE_ME
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=35673
RABBITMQ_USERNAME=itcast
RABBITMQ_PASSWORD=REPLACE_ME
RABBITMQ_VHOST=/ai-library
COMMUNICATION_MQ_ENABLED=true
COMMUNICATION_ALLOWED_ORIGINS=https://library.example.com
# Base64编码的随机密钥，解码后至少32字节；与所有应用实例保持一致。
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET
JWT_INTERCEPTOR_ENABLED=true
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
# Python AI服务与Java共享的独立随机凭据，不是用户JWT。
RECOMMENDATION_AI_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
LIBRARY_AI_URL=http://127.0.0.1:8001
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CONTEXT_LENGTH=32768
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
# 可选云端主模型；留空时按现有本地策略运行，禁止填写真实密钥后提交。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# 封面对象存储；Bucket必须是部署方自己的资源。
OSS_REGION=cn-shenzhen
OSS_BUCKET=REPLACE_ME
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
ALIBABA_CLOUD_ACCESS_KEY_ID=REPLACE_ME
ALIBABA_CLOUD_ACCESS_KEY_SECRET=REPLACE_ME
